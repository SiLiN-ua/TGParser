# Copy to .env and fill in locally. NEVER commit .env.
# Get api_id / api_hash at https://my.telegram.org (use a dedicated account).
TG_API_ID=
TG_API_HASH=
# Phone in international format, e.g. +380XXXXXXXXX (only used for login).
TG_PHONE=
TG_SESSION_NAME=tgparser
# Local PostgreSQL 17; replace CHANGE_ME with a strong password.
PG_DSN=postgresql://tgparser:CHANGE_ME@127.0.0.1:5432/tgparser
